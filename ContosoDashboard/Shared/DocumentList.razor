@using ContosoDashboard.Services
@using ContosoDashboard.Models

@if (Result == null || Result.Items.Count == 0)
{
    @EmptyContent
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => OnSort.InvokeAsync(DocumentSortBy.Title)">Title@SortIcon(DocumentSortBy.Title)</button></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => OnSort.InvokeAsync(DocumentSortBy.Category)">Category@SortIcon(DocumentSortBy.Category)</button></th>
                    <th>Project</th>
                    <th>Type</th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => OnSort.InvokeAsync(DocumentSortBy.FileSize)">Size@SortIcon(DocumentSortBy.FileSize)</button></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => OnSort.InvokeAsync(DocumentSortBy.UploadDate)">Uploaded@SortIcon(DocumentSortBy.UploadDate)</button></th>
                    <th>Uploaded by</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Result.Items)
                {
                    <tr>
                        <td>
                            @d.Title
                            @if (d.Tags.Count > 0)
                            {
                                <div>@foreach (var t in d.Tags) { <span class="badge bg-light text-dark border me-1">@t</span> }</div>
                            }
                        </td>
                        <td>@CategoryLabel(d.Category)</td>
                        <td>@(d.ProjectName ?? "—")</td>
                        <td class="text-uppercase">@d.FileType</td>
                        <td>@FormatSize(d.FileSizeBytes)</td>
                        <td>@d.UploadDate.ToLocalTime().ToString("g")</td>
                        <td>@d.UploadedByName</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/documents/@d.DocumentId/download" download>
                                <i class="bi bi-download"></i> Download
                            </a>
                            @if (d.IsPreviewable)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="/documents/@d.DocumentId/preview"
                                   target="_blank" rel="noopener">
                                    <i class="bi bi-eye"></i> Preview
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small ms-1">Preview unavailable</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Result.TotalCount document(s) — page @Query.Page of @TotalPages</span>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(Query.Page <= 1)" @onclick="() => OnPage.InvokeAsync(Query.Page - 1)">Previous</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(Query.Page >= TotalPages)" @onclick="() => OnPage.InvokeAsync(Query.Page + 1)">Next</button>
        </div>
    </div>
}

@code {
    [Parameter] public DocumentQuery Query { get; set; } = new();
    [Parameter] public PagedResult<DocumentListItem>? Result { get; set; }
    [Parameter] public bool ShowOwnerActions { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public EventCallback<DocumentSortBy> OnSort { get; set; }
    [Parameter] public EventCallback<int> OnPage { get; set; }

    private int TotalPages => Result == null ? 1 : Math.Max(1, (int)Math.Ceiling(Result.TotalCount / (double)Math.Max(1, Query.PageSize)));

    private RenderFragment SortIcon(DocumentSortBy by) => builder =>
    {
        if (Query.SortBy != by) return;
        builder.AddMarkupContent(0, Query.Descending ? " <i class=\"bi bi-caret-down-fill\"></i>" : " <i class=\"bi bi-caret-up-fill\"></i>");
    };

    private static string CategoryLabel(DocumentCategory c) => c switch
    {
        DocumentCategory.ProjectDocuments => "Project Documents",
        DocumentCategory.TeamResources => "Team Resources",
        DocumentCategory.PersonalFiles => "Personal Files",
        _ => c.ToString()
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576.0:0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B"
    };
}
